# Bu dosya ornektir. Gercek anahtarlari BURAYA yazmayin.
# Canli Render kurulumunda gizli anahtarlar Render ekranina girilir.
TELEGRAM_BOT_TOKEN=telegram_token_here
GEMINI_API_KEY=gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# 0 = botu bulan herkes kullanabilir. Kendi Telegram sayisal ID'nizle sinirlayin.
ALLOWED_USER_ID=0
# Render Free uzerinde bu dosya HER uyku/yeniden baslatmada silinir.
DB_PATH=english_buddy.sqlite3
# Kalici ilerleme icin istege bagli Neon Postgres pooled connection string:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Webhook custom domain (Render kendi adresini otomatik algilar):
# WEBHOOK_BASE_URL=https://my-service.onrender.com

# Yönetici paneli (sırları gerçek .env/Render Environment içinde tanımla)
ADMIN_PANEL_ENABLED=false
ADMIN_USER_ID=0
ADMIN_WEB_PASSWORD=
# Tavsiye: parola yöneticisiyle üretilmiş en az 32 karakterlik ayrı sır.
ADMIN_SESSION_SECRET=

# Deneysel ders kurulumu: ilk bildirimden sonra yeni kullanıcıların kaydı açılır.
# false yaparak otomatik kaydı kapatabilirsin. Eski tercihler her durumda korunur.
TRANSCRIPT_DEFAULT_ENABLED=true
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
PRIVACY_LEGAL_BASIS=
# Migration komutunda varsa bu doğrudan bağlantı kullanılır (uygulama pooled URL).
DATABASE_URL_UNPOOLED=
